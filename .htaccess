DirectoryIndex index.php index.html

RewriteEngine On

# Force HTTPS in production, but never on localhost/127.0.0.1
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct browser access to private/ folder
RewriteRule ^private/ - [F,L]

# Block direct browser access to code/data folders (src, config, database,
# scripts). Only webhook/supabase.php is a public entry point — the webhook
# logic file itself must never be reachable directly.
RewriteRule ^(src|config|database|scripts)/ - [F,L]
RewriteRule ^webhook/supabase-webhook\.php$ - [F,L]

# Serve real files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never serve dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
