# Supabase Credentials Template
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Cloudflare R2 Credentials Template
R2_BUCKET=sri-rejeki-motor
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
R2_S3_API=https://xxxxxx.r2.cloudflarestorage.com/sri-rejeki-motor
R2_S3_CLIENTS=https://xxxxxx.r2.cloudflarestorage.com
R2_TOKEN_VALUE=cfat_...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...

# Deployment & Webhook Tokens
WEBHOOK_SECRET=your_random_secret_token

# Token untuk GitHub webhook -> cpanel-deploy.php (isi string acak panjang;
# JANGAN commit nilai aslinya - file ini hanya template)
DEPLOY_WEBHOOK_TOKEN=
COOKIE_SECURE=true

# Token untuk endpoint upload gambar otomatis (api/image-upload.php, dipakai
# script Lyvi — BUKAN login admin). Buat string acak panjang, isi di
# ~/private/.env. Bila kosong, endpoint menolak semua upload (401).
IMAGE_UPLOAD_TOKEN=
